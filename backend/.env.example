# Copy to .env for local backend use. All credential entries are placeholders.
APP_NAME="AgriVerse AI Backend"
ENVIRONMENT=development
DEBUG=false
API_V1_STR=/api/v1

# Generate a random value with at least 32 bytes for production.
SECRET_KEY=replace-with-random-secret-at-least-32-bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local development can omit DATABASE_URL to use backend/agriverse.db.
# Production must use the configured PostgreSQL/Supabase direct connection URI.
DATABASE_URL=

# Provider keys remain on the backend. Empty values disable these integrations.
WEATHER_API_KEY=
WEATHER_REQUEST_TIMEOUT_SECONDS=8
GEMINI_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=20

# Optional trained YOLO weights; install requirements-ml.txt to enable inference.
DISEASE_MODEL_PATH=
DISEASE_MODEL_CONFIDENCE=0.45
DISEASE_ALLOWED_LABELS=[]

MAX_UPLOAD_BYTES=8388608
MAX_REQUEST_BYTES=10485760

# Pydantic Settings expects JSON arrays in environment files. Set exact HTTPS
# frontend origins and API hostnames before changing ENVIRONMENT to production.
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
